{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "JsonWebToken": {
    "Issuer": "http://localhost:5001",
    "Audience": "http://localhost:5001",
    "Expiration": 3600,
    "SecretKey": ""
  },
  "ReverseProxy": {
    "Routes": {
      "bookify-swagger-route": {
        "ClusterId": "bookify-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/swagger/{**catch-all}"
        }
      },
      "users-route": {
        "ClusterId": "bookify-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "bookify-route": {
        "ClusterId": "bookify-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/{**catch-all}"
        }
      },
      "bookify-booking-swagger-route": {
        "ClusterId": "bookify-booking-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/booking/swagger/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/swagger/{**catch-all}"
          }
        ]
      },
      "bookify-booking-route": {
        "ClusterId": "bookify-booking-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "bookify-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5018"
          }
        }
      },
      "bookify-booking-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5068"
          }
        }
      }
    }
  },
  "AllowedHosts": "*"
}
